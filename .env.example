# Copy to .env.local and supply a Maps SDK for Android key.
# Restrict it to com.chrfalch.oslooffsite2026 and the build's signing SHA-1.
# Re-run Android prebuild and rebuild after configuring the key.
GOOGLE_MAPS_API_KEY=

# Optional: use a local/custom endpoint serving the raw MET Norway Oslo forecast.
# Defaults to the dedicated EAS Hosting weather alias.
EXPO_PUBLIC_WEATHER_URL=
